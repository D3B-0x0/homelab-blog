---
import '@fontsource-variable/lexend';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteTitle = 'debnerd — homelab log';
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? 'Building a small homelab, documenting what broke and why.'} />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">~debnerd</a>
      <nav>
        <a href="/">log</a>
        <a href="/now">now</a>
        <a href="/rss.xml">rss</a>
        <a href="https://github.com/D3B-0x0" target="_blank" rel="noopener">github</a>
      </nav>
    </header>
    <main class="content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>built with astro · <a href="https://aboutme.debnerd.in">aboutme</a></p>
    </footer>
  </body>
</html>
